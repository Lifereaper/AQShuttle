<Window x:Class="AQShuttle.Views.CreateUserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Management" Height="550" Width="850"
        WindowStartupLocation="CenterScreen" Background="#000000" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111111" CornerRadius="12" Padding="20">
            <StackPanel>
                <TextBlock Text="👤 Create New User" FontSize="22" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock x:Name="txtError" Text="Passwords do not match!" Foreground="Red" FontSize="14" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,5,0,5"/>

                <TextBlock Text="New Username" Foreground="#888" FontSize="14" Margin="0,15,0,5"/>
                <TextBox x:Name="txtNewUsername" Padding="10" Background="#222222" Foreground="White" BorderThickness="0" FontSize="16"/>

                <TextBlock Text="Account Role" Foreground="#888" FontSize="14" Margin="0,15,0,5"/>
                <ComboBox x:Name="cmbRole" Background="#222222" Foreground="Black" SelectedIndex="1" FontSize="16" Padding="8">
                    <ComboBoxItem Content="Administrator" Foreground="DarkRed" FontWeight="Bold"/>
                    <ComboBoxItem Content="Standard User" Foreground="DarkGreen" FontWeight="Bold"/>
                </ComboBox>

                <TextBlock Text="Password" Foreground="#888" FontSize="14" Margin="0,15,0,5"/>
                <PasswordBox x:Name="txtNewPassword" Padding="10" Background="#222222" Foreground="White" BorderThickness="0" FontSize="16"/>

                <TextBlock Text="Confirm Password" Foreground="#888" FontSize="14" Margin="0,15,0,5"/>
                <PasswordBox x:Name="txtConfirmPassword" Padding="10" Background="#222222" Foreground="White" BorderThickness="0" FontSize="16"/>

                <Grid Margin="0,25,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="CLOSE" Padding="10" Background="#444444" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="BtnClose_Click"/>
                    <Button Grid.Column="2" IsDefault="True" Content="CREATE" Padding="10" Background="#00FF00" Foreground="Black" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="BtnCreate_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="#111111" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="📋 Active Accounts" FontSize="22" Foreground="White" FontWeight="Bold" Margin="0,0,0,15"/>

                <DataGrid x:Name="dgUsers" Grid.Row="1" Background="#222222" 
                          Foreground="#FFFFFF" RowBackground="#1A1A1A" AlternatingRowBackground="#2A2A2A" 
                          BorderBrush="#00FF00" BorderThickness="1" FontSize="16" 
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" 
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#444444" VerticalGridLinesBrush="Transparent">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#111111"/>
                            <Setter Property="Foreground" Value="#00FF00"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*"/>

                        <DataGridTemplateColumn Header="Action" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Delete" Background="DarkRed" Foreground="White" FontWeight="Bold" 
                                            Margin="5,2" Cursor="Hand" Click="BtnDeleteUser_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>