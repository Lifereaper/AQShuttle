<Window x:Class="AQShuttle.Views.TVDisplayView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AQ Shuttle Live Board" Height="720" Width="1280"
        WindowState="Maximized" Background="#000000"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20" HorizontalAlignment="Center">
            <TextBlock Text="AQ Belize Shuttle Schedule" FontSize="48" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="txtDate" FontSize="36" Foreground="#00FF00" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            <TextBlock x:Name="txtClock" FontSize="60" Foreground="#00FF00" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,20"/>
        </StackPanel>

        <DataGrid x:Name="dgStickyBooking" Grid.Row="1" Background="#000000" 
                  Foreground="#000000" RowBackground="#00FF00" 
                  BorderBrush="#00FF00" BorderThickness="0,0,0,3" FontSize="28" RowHeight="60" ColumnHeaderHeight="50"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" 
                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                  IsHitTestVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" SelectionChanged="dgStickyBooking_SelectionChanged" RenderTransformOrigin="0.5,0.5">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#222222"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="30"/>
                    <Setter Property="Padding" Value="15,0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="15,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.Resources>
            <DataGrid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.028"/>
                    <TranslateTransform/>
                </TransformGroup>
            </DataGrid.RenderTransform>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding BookingDate}" Width="1*"/>
                <DataGridTextColumn Header="Time" Binding="{Binding BookingTime}" Width="1*"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="1.5*"/>
                <DataGridTextColumn Header="Pick Up" Binding="{Binding Pickup}" Width="1.5*"/>
                <DataGridTextColumn Header="Dropoff" Binding="{Binding Dropoff}" Width="1.5*"/>
                <DataGridTextColumn Header="Pax" Binding="{Binding Pax}" Width="0.6*"/>
                <DataGridTextColumn Header="Bags" Binding="{Binding Bags}" Width="0.6*"/>
                <DataGridTextColumn Header="Driver" Binding="{Binding Driver}" Width="1.2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="dgScrollingBookings" Grid.Row="2" Background="#000000" 
                  ScrollViewer.CanContentScroll="False" 
                  Foreground="#FFFFFF" RowBackground="#111111" AlternatingRowBackground="#1A1A1A" 
                  BorderThickness="0" FontSize="28" RowHeight="60" 
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" 
                  HeadersVisibility="None" GridLinesVisibility="None" SelectionMode="Single"
                  IsHitTestVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
            <DataGrid.Resources>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="15,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding BookingDate}" Width="1*"/>
                <DataGridTextColumn Binding="{Binding BookingTime}" Width="1*"/>
                <DataGridTextColumn Binding="{Binding CustomerName}" Width="1.5*"/>
                <DataGridTextColumn Binding="{Binding Pickup}" Width="1.5*"/>
                <DataGridTextColumn Binding="{Binding Dropoff}" Width="1.5*"/>
                <DataGridTextColumn Binding="{Binding Pax}" Width="0.6*"/>
                <DataGridTextColumn Binding="{Binding Bags}" Width="0.6*"/>
                <DataGridTextColumn Binding="{Binding Driver}" Width="1.2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>