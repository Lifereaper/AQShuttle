<Window x:Class="AQShuttle.Views.UserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AQShuttle.Views"
        mc:Ignorable="d"
        Title="AQ Shuttle Dispatch Panel" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#000000">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00FF00"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#00FF00"/>
            <Setter Property="BorderBrush" Value="#00FF00"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="📺 TV Display" Background="#00FFFF" Foreground="Black" FontWeight="Bold" 
                        Padding="15,10" Margin="0,0,10,0" Cursor="Hand" Click="BtnTVDisplay_Click"/>
                <Button Content="⛽ Gas Calculator" Background="#FFA500" Foreground="Black" FontWeight="Bold" 
                        Padding="15,10" Cursor="Hand" Click="BtnUserCarRental_Click"/>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="AQ Shuttle Dispatch Panel" FontSize="40" HorizontalAlignment="Center" FontWeight="Bold"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Logout" Background="Red" Foreground="White" FontWeight="Bold" 
                        Padding="20,10" Cursor="Hand" Click="BtnLogout_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#0A0A0A" BorderBrush="#00FF00" BorderThickness="1" CornerRadius="10" Margin="0,20,0,0" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="10,0">
                    <TextBlock Text="Date" FontWeight="Bold"/>
                    <DatePicker x:Name="dpDate" Margin="0,5,0,15"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0">
                    <TextBlock Text="Time" FontWeight="Bold"/>
                    <TextBox x:Name="txtTime" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="10,0">
                    <TextBlock Text="Customer Name" FontWeight="Bold"/>
                    <TextBox x:Name="txtCustomerName" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="10,0">
                    <TextBlock Text="Pick Up" FontWeight="Bold"/>
                    <TextBox x:Name="txtPickup" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="10,0">
                    <TextBlock Text="Dropoff" FontWeight="Bold"/>
                    <TextBox x:Name="txtDropoff" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0">
                    <TextBlock Text="Pax (Passengers)" FontWeight="Bold"/>
                    <TextBox x:Name="txtPax" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="10,0">
                    <TextBlock Text="Bags" FontWeight="Bold"/>
                    <TextBox x:Name="txtBags" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="3" Margin="10,0">
                    <TextBlock Text="Driver" FontWeight="Bold"/>
                    <TextBox x:Name="txtDriver" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="10,0">
                    <TextBlock Text="Price" FontWeight="Bold"/>
                    <TextBox x:Name="txtPrice" />
                </StackPanel>

                <Button Grid.Row="2" Grid.Column="1" Content="ADD BOOKING" Margin="10,18,0,15"
                        Background="#00FF00" Foreground="Black" FontWeight="Bold" Cursor="Hand" Click="BtnAddBooking_Click" Grid.ColumnSpan="3"/>
            </Grid>
        </Border>

        <DataGrid x:Name="dgBookings" Grid.Row="2" Margin="0,30,0,0" Background="#111111" 
                  Foreground="#00FF00" RowBackground="#000000" AlternatingRowBackground="#0A0A0A" 
                  BorderBrush="#00FF00" BorderThickness="1" FontSize="16" AutoGenerateColumns="False" IsReadOnly="True" 
                  HeadersVisibility="Column" GridLinesVisibility="All" HorizontalGridLinesBrush="#004400" VerticalGridLinesBrush="#004400">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding BookingDate, StringFormat=d}" Width="*"/>
                <DataGridTextColumn Header="Time" Binding="{Binding BookingTime}" Width="0.8*"/>
                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="1.5*"/>
                <DataGridTextColumn Header="Pick Up" Binding="{Binding Pickup}" Width="1.5*"/>
                <DataGridTextColumn Header="Dropoff" Binding="{Binding Dropoff}" Width="1.5*"/>
                <DataGridTextColumn Header="Pax" Binding="{Binding Pax}" Width="0.5*"/>
                <DataGridTextColumn Header="Bags" Binding="{Binding Bags}" Width="0.5*"/>
                <DataGridTextColumn Header="Driver" Binding="{Binding Driver}" Width="*"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="0.8*"/>

                <DataGridTemplateColumn Header="Action" Width="1.2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Background="#222222" Foreground="Black" Margin="2"
                                      SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}" 
                                      SelectedValuePath="Content"
                                      SelectionChanged="CmbStatus_SelectionChanged">
                                <ComboBoxItem Content="Pending" Foreground="DarkOrange" FontWeight="Bold"/>
                                <ComboBoxItem Content="Completed" Foreground="Green" FontWeight="Bold"/>
                                <ComboBoxItem Content="Cancelled" Foreground="Red" FontWeight="Bold"/>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>