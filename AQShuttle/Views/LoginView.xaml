<Window x:Class="AQShuttle.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AQ Admin Login" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" Background="#000000" ResizeMode="NoResize">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="#111111" CornerRadius="12" Width="320" Padding="30">
            <StackPanel>
                <TextBlock Text="🔐 Admin Login" FontSize="24" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock x:Name="txtError" Text="Invalid Username or Password" Foreground="Red" FontSize="14" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,5,0,5"/>

                <TextBlock Text="Username" Foreground="#888" FontSize="14" Margin="0,15,0,5"/>
                <TextBox x:Name="txtUsername" Padding="12" Background="#222222" Foreground="White" BorderThickness="0" FontSize="16"/>

                <TextBlock Text="Password" Foreground="#888" FontSize="14" Margin="0,15,0,5"/>

                <Grid>
                    <PasswordBox x:Name="txtPasswordHidden" Padding="12,12,40,12" Background="#222222" Foreground="White" BorderThickness="0" FontSize="16"/>
                    <TextBox x:Name="txtPasswordVisible" Padding="12,12,40,12" Background="#222222" Foreground="White" BorderThickness="0" FontSize="16" Visibility="Collapsed"/>

                    <Button x:Name="btnShowPassword" Content="👁️" Background="Transparent" Foreground="#888" BorderThickness="0" 
                            FontSize="16" HorizontalAlignment="Right" Margin="0,0,5,0" Width="30" Cursor="Hand" Click="BtnShowPassword_Click"/>
                </Grid>

                <Button x:Name="btnLogin" IsDefault="True" Content="LOGIN" Margin="0,25,0,0" Padding="12" 
                        Background="#00FF00" Foreground="#000000" FontWeight="Bold" FontSize="16" Cursor="Hand" Click="BtnLogin_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>